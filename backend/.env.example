# Backend environment variable example file.
# Copy to backend/.env and fill in real values. Never commit backend/.env.

# MongoDB Atlas connection string (or local URI for dev).
# Atlas format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>
MONGODB_URI=

# JWT signing secret — use a random 32+ character hex string.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=

# Allowed frontend origin(s) for CORS — comma-separated.
# Local dev example:  http://localhost:5173,http://localhost:3000
# Production example: https://your-app.vercel.app
FRONTEND_URL=
